{
  "name": "nihongo-play",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "kana": "node scripts/generate-kana.mjs && node scripts/finalize-kana.mjs",
    "dev": "npm run kana && next dev",
    "build": "npm run kana && node --test tests/*.test.mjs && next build",
    "migrate": "npm run kana && node scripts/migrate.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run kana && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "1.1.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.18.3",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.2"
  }
}
